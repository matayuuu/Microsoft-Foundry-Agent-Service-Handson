# Local run. The workflow creates three agents from one FoundryChatClient, so
# both variables below are required by `python workflow.py` and `python main.py`.
# Run `az login` first. DefaultAzureCredential uses that login locally and the
# Hosted Agent managed identity after deployment.
#
# FOUNDRY_PROJECT_ENDPOINT: your Microsoft Foundry project endpoint, e.g.
# https://<account>.services.ai.azure.com/api/projects/<project> -- see the
# foundry_project_endpoint Terraform output in .workshop/context.json, or
# `terraform output foundry_project_endpoint` under infra/. Once this agent
# is deployed as a Hosted Agent, the platform injects this automatically --
# you never need to set it for the deployed version.
FOUNDRY_PROJECT_ENDPOINT=

# FOUNDRY_MODEL: the deployed model name each agent calls, e.g. the
# primary_model_deployment_name Terraform output (normally gpt-5.6-luna,
# not the gpt-5.5 query-planning/evaluation/optimizer deployment). deploy_hosted_agent.py sets
# it automatically for the deployed Hosted Agent.
FOUNDRY_MODEL=

# PORT overrides the Responses protocol's default local port (8088), useful
# if 8088 is already in use in your Codespace/devcontainer.
PORT=8088
