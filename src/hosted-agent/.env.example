# Local run. This workflow genuinely calls the Foundry model deployment
# (every one of intake_agent/policy_agent/planner_agent/approval_agent is a
# real agent_framework.Agent backed by FoundryChatClient -- see
# workflow.py), so both variables below are required for `python main.py`
# to do anything useful locally. Run `az login` first -- authentication is
# via DefaultAzureCredential, which resolves to your az login session
# locally (see README.md).
#
# FOUNDRY_PROJECT_ENDPOINT: your Microsoft Foundry project endpoint, e.g.
# https://<account>.services.ai.azure.com/api/projects/<project> -- see the
# foundry_project_endpoint Terraform output in .workshop/context.json, or
# `terraform output foundry_project_endpoint` under infra/. Once this agent
# is deployed as a Hosted Agent, the platform injects this automatically --
# you never need to set it for the deployed version.
FOUNDRY_PROJECT_ENDPOINT=

# AZURE_AI_MODEL_DEPLOYMENT_NAME: the deployed model name each agent calls,
# e.g. the primary_model_deployment_name Terraform output (see
# .workshop/context.json). scripts/deploy_hosted_agent.py sets this
# automatically on the deployed Hosted Agent from that same output -- you
# only need to set it here for a local run.
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# PORT overrides the Responses protocol's default local port (8088), useful
# if 8088 is already in use in your Codespace/devcontainer.
PORT=8088
