    {"id":"lab7-agents-text","type":"text","x":890,"y":1050,"width":670,"height":80,"fontSize":16,"fontFamily":2,"strokeColor":"#000000","text":"Lab 7 — plain Agent > Harness Agent\nFoundry IQ + Toolbox + Skills; plan / todos / execute","containerId":"lab7-agents","textAlign":"left","verticalAlign":"middle"},
    {"id":"lab8","type":"rectangle","x":870,"y":1190,"width":710,"height":170,"strokeColor":"#107C10","backgroundColor":"#DFF6DD","fillStyle":"solid","strokeWidth":2,"roughness":0,"roundness":{"type":3},"boundElements":[{"id":"lab8-text","type":"text"}]},
    {"id":"lab8-text","type":"text","x":890,"y":1210,"width":670,"height":120,"fontSize":16,"fontFamily":2,"strokeColor":"#000000","text":"Lab 8 — Hosted Agent source remote build\nintake_agent > policy_agent > reviewer_agent\nReuses Foundry IQ; no Lab 7 session state","containerId":"lab8","textAlign":"left","verticalAlign":"middle"},
