    {"id":"cleanup-steps-text","type":"text","x":80,"y":1610,"width":1480,"height":120,"fontSize":16,"fontFamily":2,"strokeColor":"#000000","text":"Export notebooks > delete Hosted Agent / versions > Compute Stop / Delete\nAzure Portal > Delete resource group > verify deletion\nDelete the dedicated RG with its resources; deployment history deletion is not resource deletion","containerId":"cleanup-steps","textAlign":"left","verticalAlign":"middle"},
