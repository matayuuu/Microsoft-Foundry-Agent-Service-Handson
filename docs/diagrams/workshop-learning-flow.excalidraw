    {"id":"preparation-title","type":"text","x":60,"y":190,"width":1520,"height":55,"fontSize":22,"fontFamily":2,"strokeColor":"#000000","text":"Labs 0–1 — prepare in Azure Portal","textAlign":"left","verticalAlign":"top"},
    {"id":"preparation-steps","type":"rectangle","x":60,"y":260,"width":1520,"height":290,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roughness":0,"roundness":{"type":3},"boundElements":[{"id":"preparation-steps-text","type":"text"}]},
    {"id":"preparation-steps-text","type":"text","x":80,"y":275,"width":1480,"height":255,"fontSize":17,"fontFamily":2,"strokeColor":"#000000","text":"Lab 0: overview and safety\n1. Resource groups > Create: manually create ONE dedicated RG\n2. Deploy a custom template > Build your own template in the editor > Load file\n3. infra/azuredeploy.json > existing RG > Review + create > Create\n4. Deployment Scripts validation passes > private ZIP download via Microsoft Entra user account\n5. PC extract: Microsoft-Foundry-Agent-Service-Handson","containerId":"preparation-steps","textAlign":"left","verticalAlign":"middle"},
    {"id":"preparation-boundary","type":"text","x":60,"y":580,"width":1520,"height":40,"fontSize":16,"fontFamily":2,"strokeColor":"#000000","text":"No Compute until Lab 7. Context = resource_outputs.<key>.value. Private container = workshop-files.","textAlign":"left","verticalAlign":"top"},
    {"id":"prepare-to-build","type":"arrow","x":415,"y":650,"width":0,"height":45,"strokeColor":"#0078D4","strokeWidth":2,"roughness":0,"points":[[0,0],[0,45]],"startArrowhead":null,"endArrowhead":"arrow"},
