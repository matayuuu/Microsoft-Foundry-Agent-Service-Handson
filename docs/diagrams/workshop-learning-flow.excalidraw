    {"id":"lab2-text","type":"text","x":80,"y":820,"width":670,"height":80,"fontSize":16,"fontFamily":2,"strokeColor":"#000000","text":"Lab 2 — Prompt Agent + direct Search\nCreate contoso-travel-assistant; Luna 40K TPM","containerId":"lab2","textAlign":"left","verticalAlign":"middle"},
