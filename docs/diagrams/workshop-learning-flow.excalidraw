    {"id":"lab7-setup","type":"rectangle","x":870,"y":810,"width":710,"height":190,"strokeColor":"#107C10","backgroundColor":"#DFF6DD","fillStyle":"solid","strokeWidth":2,"roughness":0,"roundness":{"type":3},"boundElements":[{"id":"lab7-setup-text","type":"text"}]},
    {"id":"lab7-setup-text","type":"text","x":890,"y":825,"width":670,"height":160,"fontSize":16,"fontFamily":2,"strokeColor":"#000000","text":"Lab 7 preparation: Standard_DS3_v2 + Idle shutdown\nNotebooks > User files > Upload folder\n00-azureml-setup.ipynb: Python 3.10 - SDK v2\nCreates Python (Foundry Workshop) + Python (Foundry Hosted Agent)","containerId":"lab7-setup","textAlign":"left","verticalAlign":"middle"},
