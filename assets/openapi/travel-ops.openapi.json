{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "error_code": {
            "title": "Error Code",
            "type": "string"
          }
        },
        "required": [
          "error_code",
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "PerDiemResponse": {
        "properties": {
          "city": {
            "title": "City",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "lodging_cap": {
            "description": "JPY per night",
            "title": "Lodging Cap",
            "type": "integer"
          },
          "meal_allowance": {
            "description": "JPY per day",
            "title": "Meal Allowance",
            "type": "integer"
          },
          "policy_references": {
            "items": {
              "$ref": "#/components/schemas/PolicyReferenceModel"
            },
            "title": "Policy References",
            "type": "array"
          },
          "tier": {
            "title": "Tier",
            "type": "string"
          }
        },
        "required": [
          "city",
          "date",
          "tier",
          "currency",
          "meal_allowance",
          "lodging_cap",
          "policy_references"
        ],
        "title": "PerDiemResponse",
        "type": "object"
      },
      "PolicyReferenceModel": {
        "properties": {
          "id": {
            "description": "Document id from data/manifest.json",
            "title": "Id",
            "type": "string"
          },
          "source_url": {
            "description": "Source URL for the referenced policy document. The deployed API resolves it against the configured workshop source base.",
            "title": "Source Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source_url"
        ],
        "title": "PolicyReferenceModel",
        "type": "object"
      },
      "PreapprovalRequest": {
        "properties": {
          "cabin_class": {
            "default": "economy",
            "enum": [
              "economy",
              "premium_economy",
              "business",
              "first"
            ],
            "title": "Cabin Class",
            "type": "string"
          },
          "destination_city": {
            "examples": [
              "New York"
            ],
            "minLength": 1,
            "title": "Destination City",
            "type": "string"
          },
          "end_date": {
            "format": "date",
            "title": "End Date",
            "type": "string"
          },
          "justification": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional free-text business justification. Must not contain PII.",
            "title": "Justification"
          },
          "origin_city": {
            "examples": [
              "Tokyo"
            ],
            "minLength": 1,
            "title": "Origin City",
            "type": "string"
          },
          "requester_alias": {
            "anyOf": [
              {
                "pattern": "^employee-\\d{3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional opaque synthetic requester id, e.g. 'employee-001'. Never a real name or email.",
            "title": "Requester Alias"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "traveler_count": {
            "default": 1,
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Traveler Count",
            "type": "integer"
          }
        },
        "required": [
          "origin_city",
          "destination_city",
          "start_date",
          "end_date"
        ],
        "title": "PreapprovalRequest",
        "type": "object"
      },
      "PreapprovalResponse": {
        "properties": {
          "decision": {
            "enum": [
              "simulated_auto_eligible",
              "simulated_pending_manager_review",
              "simulated_pending_vp_review"
            ],
            "title": "Decision",
            "type": "string"
          },
          "disclaimer": {
            "title": "Disclaimer",
            "type": "string"
          },
          "justification": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Justification"
          },
          "policy_references": {
            "items": {
              "$ref": "#/components/schemas/PolicyReferenceModel"
            },
            "title": "Policy References",
            "type": "array"
          },
          "reference_id": {
            "description": "Deterministic simulation reference id; not a real approval ticket number.",
            "title": "Reference Id",
            "type": "string"
          },
          "simulation": {
            "const": true,
            "default": true,
            "description": "Always true. This endpoint never grants a real approval.",
            "title": "Simulation",
            "type": "boolean"
          },
          "trip_estimate": {
            "$ref": "#/components/schemas/TripEstimateResponse"
          }
        },
        "required": [
          "reference_id",
          "decision",
          "disclaimer",
          "justification",
          "trip_estimate",
          "policy_references"
        ],
        "title": "PreapprovalResponse",
        "type": "object"
      },
      "TripEstimateRequest": {
        "properties": {
          "cabin_class": {
            "default": "economy",
            "enum": [
              "economy",
              "premium_economy",
              "business",
              "first"
            ],
            "title": "Cabin Class",
            "type": "string"
          },
          "destination_city": {
            "examples": [
              "New York"
            ],
            "minLength": 1,
            "title": "Destination City",
            "type": "string"
          },
          "end_date": {
            "format": "date",
            "title": "End Date",
            "type": "string"
          },
          "origin_city": {
            "examples": [
              "Tokyo"
            ],
            "minLength": 1,
            "title": "Origin City",
            "type": "string"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "traveler_count": {
            "default": 1,
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Traveler Count",
            "type": "integer"
          }
        },
        "required": [
          "origin_city",
          "destination_city",
          "start_date",
          "end_date"
        ],
        "title": "TripEstimateRequest",
        "type": "object"
      },
      "TripEstimateResponse": {
        "properties": {
          "cabin_class": {
            "enum": [
              "economy",
              "premium_economy",
              "business",
              "first"
            ],
            "title": "Cabin Class",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "destination_city": {
            "title": "Destination City",
            "type": "string"
          },
          "destination_tier": {
            "title": "Destination Tier",
            "type": "string"
          },
          "end_date": {
            "format": "date",
            "title": "End Date",
            "type": "string"
          },
          "flight_cost": {
            "title": "Flight Cost",
            "type": "integer"
          },
          "flight_hours": {
            "title": "Flight Hours",
            "type": "number"
          },
          "is_day_trip": {
            "title": "Is Day Trip",
            "type": "boolean"
          },
          "is_domestic": {
            "title": "Is Domestic",
            "type": "boolean"
          },
          "lodging_cost": {
            "title": "Lodging Cost",
            "type": "integer"
          },
          "manager_preapproval_required": {
            "title": "Manager Preapproval Required",
            "type": "boolean"
          },
          "meal_cost": {
            "title": "Meal Cost",
            "type": "integer"
          },
          "nights": {
            "title": "Nights",
            "type": "integer"
          },
          "origin_city": {
            "title": "Origin City",
            "type": "string"
          },
          "policy_references": {
            "items": {
              "$ref": "#/components/schemas/PolicyReferenceModel"
            },
            "title": "Policy References",
            "type": "array"
          },
          "preapproval_reasons": {
            "items": {
              "type": "string"
            },
            "title": "Preapproval Reasons",
            "type": "array"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "total_estimate": {
            "title": "Total Estimate",
            "type": "integer"
          },
          "traveler_count": {
            "title": "Traveler Count",
            "type": "integer"
          },
          "trip_reference_id": {
            "description": "Deterministic id derived from the request; not a persisted record.",
            "title": "Trip Reference Id",
            "type": "string"
          },
          "vp_preapproval_required": {
            "title": "Vp Preapproval Required",
            "type": "boolean"
          }
        },
        "required": [
          "trip_reference_id",
          "origin_city",
          "destination_city",
          "start_date",
          "end_date",
          "nights",
          "is_day_trip",
          "is_domestic",
          "destination_tier",
          "flight_hours",
          "cabin_class",
          "traveler_count",
          "currency",
          "flight_cost",
          "lodging_cost",
          "meal_cost",
          "total_estimate",
          "manager_preapproval_required",
          "vp_preapproval_required",
          "preapproval_reasons",
          "policy_references"
        ],
        "title": "TripEstimateResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nDeterministic, stateless mock **Travel Ops API** for the Contoso travel/expense\nFoundry Agent Service workshop.\n\n* No persistence: every response is computed fresh from fixed, in-memory\n  fixtures and the request payload.\n* No PII: employee identifiers, when present at all, are opaque synthetic\n  aliases such as `employee-001`.\n* `POST /preapprovals` is a **simulation only** and never grants a real\n  approval; every decision value is prefixed with `simulated_`.\n",
    "title": "Contoso Travel Ops API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness/readiness check"
      }
    },
    "/per-diem": {
      "get": {
        "operationId": "getPerDiem",
        "parameters": [
          {
            "in": "query",
            "name": "city",
            "required": true,
            "schema": {
              "examples": [
                "Osaka"
              ],
              "minLength": 1,
              "title": "City",
              "type": "string"
            }
          },
          {
            "description": "Trip date (ISO 8601)",
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "description": "Trip date (ISO 8601)",
              "format": "date",
              "title": "Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PerDiemResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown city."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid or disallowed request."
          }
        },
        "summary": "Look up the deterministic per-diem meal allowance and lodging cap for a city"
      }
    },
    "/preapprovals": {
      "post": {
        "operationId": "createPreapproval",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreapprovalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreapprovalResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown city."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid or disallowed request."
          }
        },
        "summary": "Simulate a travel preapproval decision (never a real approval)"
      }
    },
    "/trip-estimates": {
      "post": {
        "operationId": "createTripEstimate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripEstimateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripEstimateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown city."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid or disallowed request."
          }
        },
        "summary": "Produce a deterministic flight/lodging/meal cost estimate for a trip"
      }
    }
  },
  "servers": [
    {
      "url": "https://replace-with-your-travel-api.example.invalid"
    }
  ]
}
