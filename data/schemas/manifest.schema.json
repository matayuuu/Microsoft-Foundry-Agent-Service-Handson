{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "{{WORKSHOP_SOURCE_BASE}}/data/schemas/manifest.schema.json",
  "title": "Travel Ops corpus manifest",
  "description": "Deterministic manifest describing search-index partitions and every synthetic corpus document, receipt fixture, trip fixture, and evaluation file shipped under data/. bootstrap_data.py uses this contract to verify checksums before indexing content into Azure AI Search / Foundry IQ.",
  "type": "object",
  "required": [
    "corpus_version",
    "language",
    "source_url_base_placeholder",
    "chunking",
    "embedding",
    "citation",
    "search_indexes",
    "documents",
    "receipts",
    "fixtures",
    "evaluation"
  ],
  "additionalProperties": false,
  "properties": {
    "corpus_version": {
      "type": "string",
      "description": "Semantic-ish version for the corpus content, bumped whenever any document, fixture, or eval file changes.",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"
    },
    "language": {
      "type": "string",
      "const": "ja"
    },
    "source_url_base_placeholder": {
      "type": "string",
      "description": "The literal placeholder token embedded in every source_url. Bootstrap/setup tooling substitutes this token with a stable, configurable repository base (e.g. a raw content URL or portal-visible path) rather than a fake live external domain.",
      "const": "{{WORKSHOP_SOURCE_BASE}}"
    },
    "chunking": {
      "type": "object",
      "description": "Default chunking contract applied when indexing documents for Azure AI Search / Foundry IQ. Individual pipelines may override these values, but must document any deviation.",
      "required": ["strategy", "max_tokens", "overlap_tokens", "unit"],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["markdown-heading"]
        },
        "unit": {
          "type": "string",
          "enum": ["tokens"]
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "overlap_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "embedding": {
      "type": "object",
      "description": "Default embedding configuration. dimensions is intentionally configurable by setup so the workshop can target different embedding models without touching the corpus.",
      "required": ["default_dimensions", "configurable_by"],
      "additionalProperties": false,
      "properties": {
        "default_dimensions": {
          "type": "integer",
          "minimum": 1
        },
        "configurable_by": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "citation": {
      "type": "object",
      "description": "Contract for the fields an agent or evaluator must surface when citing a document.",
      "required": ["required_fields"],
      "additionalProperties": false,
      "properties": {
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["id", "title", "source_url", "effective_date"]
          },
          "minItems": 1
        }
      }
    },
    "search_indexes": {
      "type": "array",
      "description": "Search indexes seeded by setup. document_ids partition the policy corpus so the workshop can compare single-source direct retrieval with multi-source agentic retrieval.",
      "minItems": 1,
      "items": { "$ref": "#/$defs/searchIndex" }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    },
    "receipts": { "$ref": "#/$defs/fileGroup" },
    "fixtures": { "$ref": "#/$defs/fileGroup" },
    "evaluation": { "$ref": "#/$defs/fileGroup" }
  },
  "$defs": {
    "searchIndex": {
      "type": "object",
      "required": ["name", "document_ids"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,126}[a-z0-9]$"
        },
        "document_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^policy-[a-z0-9-]+-[0-9]{3}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "document": {
      "type": "object",
      "required": [
        "id",
        "title",
        "category",
        "path",
        "effective_date",
        "applies_to",
        "source_url",
        "sha256",
        "size_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^policy-[a-z0-9-]+-[0-9]{3}$"
        },
        "title": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": [
            "general_policy",
            "flights",
            "hotels",
            "per_diem_meals",
            "ground_transport",
            "receipts",
            "international_security",
            "accessibility_exceptions",
            "approval_process",
            "faq"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^policies/[a-zA-Z0-9._-]+\\.md$"
        },
        "effective_date": {
          "type": "string",
          "format": "date"
        },
        "applies_to": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "source_url": {
          "type": "string",
          "pattern": "^\\{\\{WORKSHOP_SOURCE_BASE\\}\\}/data/policies/[a-zA-Z0-9._-]+\\.md$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fileGroup": {
      "type": "object",
      "description": "One or more named files with checksums, used for receipts, trip fixtures, and evaluation JSONL sets.",
      "required": ["files"],
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "path", "sha256", "size_bytes"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
